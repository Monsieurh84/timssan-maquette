{
  "sections": {
    "main": {
      "type": "tm-main-product",
      "settings": {},
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant": {
          "type": "variant"
        },
        "buy": {
          "type": "buy",
          "settings": {
            "label": "Choisir ma taille",
            "fit": "Taille normalement"
          }
        },
        "perks": {
          "type": "perks",
          "settings": {
            "t1": "4,8/5 sur Trustpilot",
            "s1": "Excellent",
            "t2": "Échanges gratuits",
            "s2": "Sous 14 jours",
            "t3": "Livraison gratuite & express",
            "s3": "En 24/48h"
          }
        },
        "reviews": {
          "type": "reviews_anchor",
          "settings": {
            "heading": "Avis clients"
          }
        },
        "acc": {
          "type": "accordion",
          "settings": {}
        },
        "id": {
          "type": "idcard",
          "settings": {}
        },
        "loox_rating": {
          "type": "shopify://apps/loox-reviews/blocks/loox-rating/5c3b337f-fd14-4df5-b1d6-80ec13e6e28e",
          "settings": {
            "contentSize": 15,
            "pattern": "[count] avis",
            "hideText": false,
            "alignment": "",
            "layout": "",
            "textColor": "",
            "starColor": "#0F2E4B",
            "showAllReviews": false,
            "looxOpenFloatingWidget": false,
            "emptyRatingWidget": false
          }
        },
        "alma": {
          "type": "shopify://apps/alma-widget/blocks/alma_widget_block/4f38fc15-ea4e-44b3-96e0-0c0f2daa413f",
          "settings": {
            "display_widget_not_eligible": true,
            "widget_position": "flex-start",
            "update_quantity_in_widget": true,
            "widget_monochrome": true
          }
        },
        "loox_carousel": {
          "type": "shopify://apps/loox-reviews/blocks/loox-testimonial-carousel-section/5c3b337f-fd14-4df5-b1d6-80ec13e6e28e",
          "settings": {
            "maxWidth": 600,
            "desktopFontSize": 14,
            "mobileFontSize": 14,
            "maxNumberOfCharacters": 180,
            "quoteMarkIcon": "none",
            "reviewerNameColor": "#0F2E4B",
            "textColor": "#0F2E4B",
            "starsColor": "#0F2E4B",
            "quotesIconColor": "#C5CBCC",
            "arrows_iconColor": "#0F2E4B",
            "arrows_hideOnMobile": true,
            "pagination_active": true,
            "pagination_selectedDotColor": "#0F2E4B",
            "pagination_dotColor": "#C5CBCC",
            "autoplay_active": true,
            "autoplay_duration": 5,
            "productIds": ""
          }
        },
        "bullets": {
          "type": "bullets",
          "settings": {}
        },
        "stock": {
          "type": "stock",
          "settings": {
            "cutoff": 12
          }
        }
      },
      "block_order": [
        "title",
        "loox_rating",
        "price",
        "bullets",
        "variant",
        "buy",
        "stock",
        "perks",
        "alma",
        "reviews",
        "loox_carousel",
        "acc",
        "id"
      ]
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "Complète la tenue",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "reass": {
      "type": "tm-reassurance",
      "settings": {
        "space": 48
      },
      "blocks": {
        "r0": {
          "type": "item",
          "settings": {
            "title": "Livraison offerte 24/48h",
            "text": "France métropolitaine"
          }
        },
        "r1": {
          "type": "item",
          "settings": {
            "title": "Échange offert",
            "text": "Pas la bonne taille ? On échange"
          }
        },
        "r2": {
          "type": "item",
          "settings": {
            "title": "14 jours pour changer d'avis",
            "text": "Retours simples"
          }
        },
        "r3": {
          "type": "item",
          "settings": {
            "title": "Paiement 3 ou 4 fois",
            "text": "Sans frais, 100 % sécurisé"
          }
        }
      },
      "block_order": [
        "r0",
        "r1",
        "r2",
        "r3"
      ]
    },
    "bloc1": {
      "type": "tm-story",
      "settings": {
        "image": "{{ product.metafields.custom.product_image_1.value }}",
        "title": "{{ product.metafields.custom.title_bloc_1.value }}",
        "text": "<p>{{ product.metafields.custom.description_bloc_1 | metafield_tag }}</p>",
        "flip": false,
        "label": "[ Le détail qui compte ]"
      }
    },
    "bloc2": {
      "type": "tm-story",
      "settings": {
        "image": "{{ product.metafields.custom.product_image_2.value }}",
        "title": "{{ product.metafields.custom.title_bloc_2.value }}",
        "text": "<p>{{ product.metafields.custom.description_bloc_2 | metafield_tag }}</p>",
        "flip": true,
        "label": "[ Pensé pour la vraie vie ]"
      }
    },
    "reviews": {
      "type": "apps",
      "blocks": {
        "lx": {
          "type": "shopify://apps/loox-reviews/blocks/loox-dynamic-section/5c3b337f-fd14-4df5-b1d6-80ec13e6e28e",
          "settings": {
            "reviews_to_display": "",
            "default_tab": "automatic",
            "only_photos": false,
            "aggregated": false,
            "limit": 8,
            "hide_thumbnails": false,
            "maxwidth": 1080,
            "is_sample": false
          }
        }
      },
      "block_order": [
        "lx"
      ],
      "settings": {
        "include_margins": true
      }
    },
    "faq": {
      "type": "tm-faq",
      "blocks": {
        "qa1": {
          "type": "qa",
          "settings": {
            "q": "Comment garantissez-vous la sécurité des transactions en ligne ?",
            "a": "<p>Nous garantissons la sécurité des paiements en ligne en utilisant Stripe et PayPal, des services reconnus pour leur sécurité à 100%.</p>"
          }
        },
        "qa2": {
          "type": "qa",
          "settings": {
            "q": "Combien de temps faut-il pour la livraison ?",
            "a": "<p>Nous expédions les commandes dans les 24/48 heures, sauf les week-ends et jours fériés. Le délai de livraison dépend de votre adresse et du mode de livraison choisi. Lors de votre commande, nous vous fournirons une estimation du délai de livraison pour une livraison à domicile.</p>"
          }
        },
        "qa3": {
          "type": "qa",
          "settings": {
            "q": "Quelle est votre politique de retour et d'échange ?",
            "a": "<p>Vous pouvez retourner les pantalons dans les 14 jours, à condition qu'ils soient dans leur emballage d'origine, avec étiquettes et sans taches. Pour initier un retour : <a href=\"https://go.ifreturns.com/fr/timssan\" title=\"Commencer le retour\">commencer le retour</a>.</p>"
          }
        },
        "qa4": {
          "type": "qa",
          "settings": {
            "q": "Que faire si j'ai reçu un article défectueux ou endommagé ?",
            "a": "<p>Contactez immédiatement notre service client à <a href=\"mailto:serviceclient@timssan.com\" title=\"serviceclient@timssan.com\">serviceclient@timssan.com</a>. Nous nous engageons à résoudre rapidement votre problème.</p>"
          }
        }
      },
      "block_order": [
        "qa1",
        "qa2",
        "qa3",
        "qa4"
      ],
      "settings": {
        "label": "Questions fréquentes",
        "heading": "FAQ",
        "link_label": "Toutes les questions",
        "link": "/pages/faqs",
        "open_first": false
      }
    }
  },
  "order": [
    "main",
    "bloc1",
    "bloc2",
    "reviews",
    "faq",
    "related",
    "reass"
  ]
}