{%- comment -%}
  Timssan · Anatomie d'un produit : photo + points numérotés, modifiables dans l'éditeur de thème.
  Un seul champ « Produit présenté » : photo, nom, prix et lien suivent automatiquement.
  Chaque point = un bloc « Point » (titre, texte, position en %).
{%- endcomment -%}
{%- liquid
  assign p = section.settings.product
  assign im = section.settings.image
  if im == blank and p != blank
    assign idx = section.settings.img_index | minus: 1
    assign im = p.images[idx] | default: p.featured_image
  endif
-%}
<section class="t-sec tm" id="anatomie-{{ section.id }}">
  <div class="t-wrap t-anat" data-tm-anat>
    <div class="t-anat-img{% if section.settings.fit == 'contain' %} t-contain{% endif %}">
      {%- if im != blank -%}
        {{ im | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,800,1200', sizes: '(max-width: 860px) 100vw, 50vw', alt: p.title | default: section.settings.heading }}
      {%- else -%}
        <span class="t-anat-empty t-muted">Choisissez un produit dans l'éditeur</span>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <button class="t-pin" type="button" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%" data-pin="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</button>
      {%- endfor -%}
    </div>
    <div>
      <div class="t-label t-muted" style="margin-bottom:12px">{{ section.settings.label | escape }}{% if p != blank %} · <a href="{{ p.url }}">{% render 'tm-name', product: p, part: 'name' %}</a>{% endif %}</div>
      <h2 class="t-disp" style="font-size:clamp(46px,5.8vw,92px);margin-bottom:28px">{{ section.settings.heading | escape | replace: '|', '<br>' }}</h2>
      <div>
        {%- for block in section.blocks -%}
          <button class="t-spec{% if forloop.first %} t-on{% endif %}" type="button" data-spec="{{ forloop.index0 }}"><span class="t-n">[{{ forloop.index | prepend: '0' | slice: -2, 2 }}]</span><span><h4>{{ block.settings.title | escape }}</h4><p>{{ block.settings.text | escape }}</p></span></button>
        {%- endfor -%}
      </div>
      {%- if p != blank and section.settings.show_button -%}
        <a class="t-btn t-anat-cta" href="{{ p.url }}">{{ section.settings.button_label | escape }} · {% render 'tm-price', product: p %}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  #anatomie-{{ section.id }} .t-anat-img.t-contain{background:#fff}
  #anatomie-{{ section.id }} .t-anat-img.t-contain img{object-fit:contain}
  #anatomie-{{ section.id }} .t-anat-empty{position:absolute;inset:0;display:grid;place-items:center;font-size:14px}
  #anatomie-{{ section.id }} .t-anat-cta{margin-top:28px;display:inline-flex}
  #anatomie-{{ section.id }} .t-pin{z-index:2;cursor:pointer}
</style>
{%- if request.design_mode -%}
<script>
  /* Éditeur : sélectionner un bloc « Point » allume son point sur la photo */
  document.addEventListener('shopify:block:select', function (e) {
    var pin = e.target.closest && e.target.closest('.t-pin'); if (!pin) return;
    var root = pin.closest('[data-tm-anat]'); if (!root) return;
    root.querySelectorAll('.t-pin').forEach(function (p) { p.setAttribute('aria-pressed', String(p === pin)); });
    root.querySelectorAll('.t-spec').forEach(function (s) { s.classList.toggle('t-on', s.dataset.spec === pin.dataset.pin); });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "T · Anatomie",
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "Choisissez le produit présenté : sa photo, son nom, son prix et son lien se mettent à jour tout seuls. Ajoutez ensuite un bloc « Point » par détail à montrer." },
    { "type": "product", "id": "product", "label": "Produit présenté" },
    { "type": "range", "id": "img_index", "label": "Photo du produit à utiliser (n°)", "min": 1, "max": 20, "step": 1, "default": 1, "info": "1 = première photo de la fiche produit." },
    { "type": "image_picker", "id": "image", "label": "…ou une autre image (remplace la photo du produit)" },
    { "type": "select", "id": "fit", "label": "Cadrage de l'image", "default": "cover", "options": [
      { "value": "cover", "label": "Remplir le cadre" },
      { "value": "contain", "label": "Image entière (fond blanc)" }
    ] },
    { "type": "text", "id": "label", "label": "Étiquette", "default": "Anatomie d'un jogpant" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Droit. Juste.|Pas compliqué.", "info": "Le signe | fait un retour à la ligne." },
    { "type": "checkbox", "id": "show_button", "label": "Afficher le bouton vers le produit", "default": true },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Voir le modèle" }
  ],
  "blocks": [
    { "type": "spec", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "La ceinture" },
      { "type": "textarea", "id": "text", "label": "Texte", "default": "Élastiquée à l'arrière, nette à l'avant." },
      { "type": "paragraph", "content": "Placez le point sur la photo :" },
      { "type": "range", "id": "x", "label": "Gauche ↔ droite (%)", "min": 0, "max": 100, "step": 1, "default": 50 },
      { "type": "range", "id": "y", "label": "Haut ↕ bas (%)", "min": 0, "max": 100, "step": 1, "default": 20 }
    ] }
  ],
  "presets": [{ "name": "T · Anatomie", "blocks": [{ "type": "spec" }] }]
}
{% endschema %}
