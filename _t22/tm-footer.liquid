{%- comment -%} Timssan · pied de page : texte de marque, menus, moyens de paiement officiels, signature Built for everyday {%- endcomment -%}
<footer class="t-footer tm">
  <div class="t-wrap">
    <div class="t-ft">
      <div>
        <h5>{{ section.settings.title | escape }}</h5>
        <p style="margin:0 0 18px;max-width:38ch">{{ section.settings.text | escape }}</p>
        {%- if section.settings.show_payment -%}
          <ul class="t-pay" aria-label="Moyens de paiement acceptés">
            {%- assign wl = section.settings.pay_types | remove: ' ' | split: ',' -%}
            {%- if wl.size == 0 -%}
              {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
            {%- else -%}
              {%- for type in wl -%}{%- if shop.enabled_payment_types contains type -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endif -%}{%- endfor -%}
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign m = block.settings.menu -%}
        <div {{ block.shopify_attributes }}>
          <h5>{{ block.settings.heading | default: m.title | escape }}</h5>
          {%- if m.links.size > 0 -%}
            <ul>{%- for link in m.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}</ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="t-foot-sign">
      <div class="t-wordmark" aria-hidden="true"><b>TIMSSAN</b><small>BUILT FOR EVERYDAY</small></div>
    </div>
    <div class="t-legal">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · Tous droits réservés</span>
      {%- if section.settings.credit != blank -%}<span class="t-credit">{{ section.settings.credit }}</span>{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "T · Pied de page",
  "class": "tm-footer-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Timssan" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Des pantalons casual premium, bien coupés et agréables à porter, fabriqués dans le respect de l'humain et du savoir-faire." },
    { "type": "checkbox", "id": "show_payment", "label": "Afficher les moyens de paiement", "default": true },
    { "type": "text", "id": "pay_types", "label": "Logos à afficher (codes Shopify)", "default": "cartes_bancaires,visa,master,american_express,paypal,apple_pay,google_pay,shopify_pay,bancontact" },
    { "type": "richtext", "id": "credit", "label": "Crédit", "default": "<p>Développé par <a href=\"https://lesmonsieurs.fr\">Monsieur.H</a></p>" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de liens",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titre" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
