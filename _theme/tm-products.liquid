<section class="t-sec tm" id="tm-{{ section.id }}">
  <div class="t-wrap">
    <div class="t-sec-head">
      <div>{%- if section.settings.label != blank -%}<div class="t-label t-muted" style="margin-bottom:12px">{{ section.settings.label | escape }}</div>{%- endif -%}<h2 class="t-disp">{{ section.settings.heading | escape | replace: '|', '<br>' }}</h2></div>
      {%- if section.settings.link_label != blank -%}<a class="t-btn t-ghost" href="{{ section.settings.link | default: section.settings.collection.url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
    <div class="t-grid-p">
      {%- assign c = section.settings.collection -%}
      {%- if c.metafields._up.variant_cards_enable.value and c.metafields._up.variant_cards.value.size > 0 -%}
        {%- assign shown = 0 -%}
        {%- for v in c.metafields._up.variant_cards.value -%}
          {%- if v.product == blank -%}{%- continue -%}{%- endif -%}
          {%- render 'tm-card', product: v.product, variant: v -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
      {%- else -%}
      {%- for p in c.products limit: section.settings.limit -%}
        {%- render 'tm-card', product: p -%}
      {%- else -%}
        <p class="t-muted">Choisissez une collection dans l'éditeur.</p>
      {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "T · Produits",
  "settings": [
    { "type": "text", "id": "label", "label": "Étiquette", "default": "Les plus portés en ce moment" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Les essentiels|de la maison" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Voir tous les pantalons →" },
    { "type": "url", "id": "link", "label": "URL" }
  ],
  "presets": [{ "name": "T · Produits" }]
}
{% endschema %}
