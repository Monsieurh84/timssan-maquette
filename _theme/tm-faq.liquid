{%- comment -%} Timssan · FAQ en accordéons (fiche produit, pages). Données structurées FAQPage pour Google. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="t-sec tm t-faq" id="faq-{{ section.id }}">
  <div class="t-wrap t-faq-in">
    <div class="t-faq-h">
      {%- if section.settings.label != blank -%}<div class="t-label t-muted">{{ section.settings.label | escape }}</div>{%- endif -%}
      <h2 class="t-disp">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}<a class="t-lnk" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
    <div class="t-acc">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.q | escape }}</summary>
          <div class="t-in t-rte">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        { "@type": "Question", "name": {{ block.settings.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
{%- endif -%}

{% schema %}
{
  "name": "T · FAQ",
  "class": "tm-faq-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Sur-titre", "default": "Questions fréquentes" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "FAQ" },
    { "type": "text", "id": "link_label", "label": "Lien (texte)", "default": "Toutes les questions" },
    { "type": "url", "id": "link", "label": "Lien", "default": "/pages/faqs" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": false }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "q", "label": "Question" },
        { "type": "richtext", "id": "a", "label": "Réponse" }
      ]
    }
  ],
  "presets": [{ "name": "T · FAQ" }]
}
{% endschema %}
